# soma: copy to web/.env.local (and bridge/.env for the bridge). Names must match exactly;
# values are examples. The web app reads every variable listed under "web"; the sync pipeline
# and the bridge read the rest. Nothing here is committed with a real value.

# ---- database (web, sync, bridge) ----
DATABASE_URL=postgresql://soma_app:password@127.0.0.1:5432/soma   # local Postgres; on Vercel the estate gateway URL (pg.<domain>, HTTP driver)

# ---- web: auth ----
AUTH_SECRET=change-me-32-random-chars                              # NextAuth session secret
AUTH_TRUST_HOST=true                                               # required behind a proxy or on Vercel
GITHUB_CLIENT_ID=                                                  # GitHub OAuth app (web sign-in)
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_USERNAME=drkostas                                     # the one GitHub login allowed to sign in
SOMA_API_TOKEN=change-me                                           # bearer for the native app and scripts (bypasses the session)
CRON_SECRET=change-me-32-random-chars                              # Vercel Cron / GitHub Actions call the cron routes with this bearer

# ---- web: addresses ----
NEXT_PUBLIC_BASE_URL=http://localhost:3456                         # the web's own public URL
SOMA_WEB_URL=http://localhost:3456                                 # the same, read server-side by the sync and the bridge
NEXT_PUBLIC_SOMA_CHAT_BASE=                                        # chat base URL for the browser (empty = same origin)

# ---- web: demo ----
DEMO_MODE=false                                                    # true = read-only public demo (mutating API calls refused)
NEXT_PUBLIC_IS_DEMO=false                                          # true = the demo banner and sample-data notice

# ---- web: chat (Claude Code over the tailnet) ----
SOMA_CHAT_TUNNEL_URL=                                              # where the chat is mounted (tailscale serve on the pinned host)
SOMA_CHAT_TOKEN=change-me                                          # shared secret between the web and the chat mount
SOMA_CHAT_ALLOWED_ORIGIN=                                          # origin allowed to call the chat routes
SOMA_CHAT_TAILNET_LOGIN=                                           # tailnet login the chat mount accepts
CLAUDE_CMD=claude                                                  # the Claude Code binary the estimate and chat routes spawn
SOMA_ESTIMATE_MODEL=sonnet                                         # model for the ingredient estimate route

# ---- web: push notifications ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- web + sync: integrations ----
HEVY_API_KEY=                                                      # Hevy API key (hevy.com settings)
HEVY_WEBHOOK_SECRET=                                               # Hevy webhook signature secret
HEVY2GARMIN_TIMEZONE=Europe/Athens                                 # timezone for the workout sync
GARMIN_EMAIL=                                                      # Garmin Connect login (sync pipeline)
GARMIN_PASSWORD=
STRAVA_CLIENT_ID=                                                  # Strava API app (sync + web)
STRAVA_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=                                                 # Spotify app (playlist DJ)
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3456/api/playlist/callback
LASTFM_API_KEY=
TELEGRAM_BOT_TOKEN=                                                # notifications
TELEGRAM_CHAT_ID=
GITHUB_PAT=                                                        # dispatches the sync workflow on your fork
GITHUB_REPO_OWNER=drkostas                                         # the fork the web dispatches to
GITHUB_REPO_NAME=soma
GITHUB_REPO=drkostas/soma
