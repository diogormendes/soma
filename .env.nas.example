# Copy this file to .env on the NAS. Never commit the filled-in .env.

# Existing PostgreSQL/Neon database used by Soma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
AUTH_TRUST_HOST=true

# URL users open in the browser. Keep it identical to the GitHub OAuth App URL.
NEXT_PUBLIC_BASE_URL=http://NAS-IP:3456
SOMA_WEB_URL=http://NAS-IP:3456
GITHUB_OWNER_USERNAME=diogormendes

# GitHub OAuth App; callback is ${NEXT_PUBLIC_BASE_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Optional: enables Sync Now and native-app API access.
GITHUB_PAT=
GITHUB_REPO_OWNER=diogormendes
GITHUB_REPO_NAME=soma
GITHUB_REPO=diogormendes/soma
SOMA_API_TOKEN=
CRON_SECRET=

# Optional integrations.
HEVY_API_KEY=
HEVY_WEBHOOK_SECRET=
GARMIN_EMAIL=
GARMIN_PASSWORD=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://NAS-IP:3456/api/playlist/callback
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Keep the full app enabled. Set true only for a deliberate read-only demo.
DEMO_MODE=false
NEXT_PUBLIC_IS_DEMO=false
